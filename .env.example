# ───────────────────────────────────────────────────────────────
# Globistic Custom Apparel — Environment Variables
# Copy this file to `.env` and fill in real values.
# ───────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globistic?schema=public"

# JWT / Auth — generate strong random secrets (e.g. `openssl rand -base64 48`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Used to sign CSRF / password-reset tokens
APP_SECRET="change-me-too-another-long-random-string"

# Square Payments
# Use https://developer.squareup.com to obtain credentials
SQUARE_ENVIRONMENT="sandbox"            # "sandbox" | "production"
SQUARE_ACCESS_TOKEN="your-square-access-token"
SQUARE_LOCATION_ID="your-square-location-id"
NEXT_PUBLIC_SQUARE_APP_ID="your-square-application-id"
NEXT_PUBLIC_SQUARE_LOCATION_ID="your-square-location-id"

# AWS S3 (design uploads, mockups, previews)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="globistic-uploads"
# Optional public CDN/base URL for serving objects
S3_PUBLIC_URL=""

# Email (SMTP) — for transactional notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@globistic.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Globistic <no-reply@globistic.com>"

# Seed admin (created by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@globistic.com"
SEED_ADMIN_PASSWORD="Admin123!"
